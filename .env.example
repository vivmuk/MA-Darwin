# Copy this file to `.env` in the repo root, then fill in your key:
#   copy .env.example .env
#
# The backend loads `.env` automatically when the API / CLI starts.
# Never commit your real `.env` (it is gitignored).

# -----------------------------------------------------------------------------
# LLM provider — pick ONE (first match wins: Venice → OpenRouter → Anthropic)
# -----------------------------------------------------------------------------

# Option A: Venice AI (OpenAI-compatible)
# Example curl:
#   curl https://api.venice.ai/api/v1/chat/completions \
#     -H "Authorization: Bearer YOUR_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"model":"venice-uncensored","messages":[{"role":"user","content":"Hello!"}]}'
VENICE_API_KEY=VENICE_INFERENCE_KEY_your-key-here
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=claude-opus-4-8
# CORS_ORIGINS=*
# MA_DARWIN_RELAX_FONTS=1

# Option B: OpenRouter (Anthropic Messages API compatible)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Option C: Anthropic direct
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# Judge / run behaviour (optional)
# -----------------------------------------------------------------------------
# auto = use LLM when a key is set, else heuristics
# llm  = prefer LLM path when configured
# heuristic = never call the LLM for Gate 3
# MA_DARWIN_JUDGE=auto

# -----------------------------------------------------------------------------
# Frontend → API (optional; only needed when pointing Next.js at FastAPI)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE=http://localhost:8000
# API_UPSTREAM=http://localhost:8000
