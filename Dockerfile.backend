# Railway backend: FastAPI + skill scripts + LibreOffice for thumbnails/QA.
# Optional UI: the exported Next.js app is copied to frontend/out so `/` serves the product.
FROM node:22-bookworm-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build:static

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend \
    MA_DARWIN_RELAX_FONTS=1 \
    VENICE_MODEL=claude-opus-4-8 \
    SAL_USE_VCLPLUGIN=svp

RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-impress \
        fonts-liberation \
        fonts-liberation-sans-narrow \
        fonts-crosextra-carlito \
        fonts-dejavu-core \
        fonts-dejavu-extra \
        poppler-utils \
        libcairo2 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libgdk-pixbuf-2.0-0 \
        shared-mime-info \
        libxml2 \
        libxslt1.1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY backend ./backend
COPY skills ./skills
COPY blueprints ./blueprints
COPY config ./config
COPY prompts ./prompts
COPY docs ./docs
COPY openapi.yaml ./
COPY --from=frontend /frontend/out /app/frontend/out
COPY --from=frontend /frontend/out /app/backend/web

RUN pip install --no-cache-dir -e .

EXPOSE 8000
CMD ["sh", "-c", "python -m uvicorn app.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
